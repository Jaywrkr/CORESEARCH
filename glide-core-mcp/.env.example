# Credenciales de Glide — completar con tus valores reales en un archivo .env
# NUNCA subir el .env real a git. Este archivo es solo un ejemplo con placeholders.

# Token de la API de Glide (Settings > API en tu app de Glide, plan Business/Enterprise)
GLIDE_TOKEN=REEMPLAZAR_CON_TU_TOKEN_DE_GLIDE

# ID de la app de Glide (se ve en la URL de la app o en el modal "Show API")
GLIDE_APP_ID=REEMPLAZAR_CON_TU_APP_ID

# ID de la tabla de proyectos dentro de la app (modal "Show API" > seleccionar la tabla)
GLIDE_TABLE_ID=REEMPLAZAR_CON_TU_TABLE_ID

# --- Solo para el deploy remoto (server-http.js / Railway) ---
# Token propio del servidor MCP (NO es el de Glide) para autenticar quién
# puede llamar al servidor una vez que queda con URL pública. Generalo con,
# por ejemplo: openssl rand -hex 32
MCP_SERVER_TOKEN=REEMPLAZAR_CON_UN_TOKEN_PROPIO_GENERADO_POR_VOS

# Puerto HTTP (Railway lo inyecta solo — no hace falta setearlo a mano ahí).
PORT=3000
